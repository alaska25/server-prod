# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB (Atlas connection string)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adyoolau?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# S3-compatible storage (AWS S3, DigitalOcean Spaces, etc.)
S3_REGION=us-east-1
S3_BUCKET=adyoolau-books
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
# Only needed for non-AWS S3-compatible providers (e.g. DigitalOcean Spaces).
# Leave blank for real AWS S3.
S3_ENDPOINT=
S3_PUBLIC_URL_BASE=https://adyoolau-books.s3.amazonaws.com
